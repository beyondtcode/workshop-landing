# Monday WorkForm short link: https://wkf.ms/4uCYfL8
VITE_MONDAY_FORM_TOKEN=4uCYfL8

# Required for custom-site submissions (Monday public API returns 401 without a browser session).
# Create a token at https://monday.com/developers/apps — needs boards:read + boards:write.
MONDAY_API_TOKEN=
# Board ID where form responses should appear (from the board URL, not the form short link).
MONDAY_BOARD_ID=

# Optional status column ID on the board (defaults to "status").
# MONDAY_STATUS_COLUMN_ID=status

# Optional overrides for question column IDs (auto-loaded from the public form page in dev).
# VITE_MONDAY_QUESTION_NAME=name
# VITE_MONDAY_QUESTION_EMAIL=emailh699gboe
# VITE_MONDAY_QUESTION_PHONE=phoneafm25cvv
